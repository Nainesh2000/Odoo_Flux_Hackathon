                <span className="absolute top-0 right-0 block h-2 w-2 rounded-full bg-red-500 ring-2 ring-white dark:ring-slate-900"></span>
              </button>
              {showNotifications && (
                <div className="absolute right-0 mt-2 w-80 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg z-50 overflow-hidden">
                  <div className="p-3 border-b border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 font-semibold text-sm">Notifications</div>
                  <div className="max-h-64 overflow-y-auto">
                    <div className="p-3 border-b border-slate-100 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/50 cursor-pointer">
                      <p className="text-sm font-medium text-slate-800 dark:text-slate-200">New Subscription Added</p>
                      <p className="text-xs text-slate-500 dark:text-slate-400 mt-1">Netflix Premium activated for Ravi Kumar.</p>
                      <p className="text-[10px] text-slate-400 mt-2">10 mins ago</p>
                    </div>
                    <div className="p-3 border-b border-slate-100 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/50 cursor-pointer">
                      <p className="text-sm font-medium text-slate-800 dark:text-slate-200">Payment Failed</p>
                      <p className="text-xs text-slate-500 dark:text-slate-400 mt-1">INV-2026-1043 payment declined.</p>
                      <p className="text-[10px] text-slate-400 mt-2">1 hour ago</p>
